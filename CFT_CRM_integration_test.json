    {
      "name": "Analytics",
      "item": [
        {
          "name": "23. Top seller — day",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();",
                  "const today = now.toISOString().slice(0, 10);",
                  "pm.collectionVariables.set(\"today\", today);",
                  "pm.collectionVariables.set(\"thisMonth\", today.slice(0, 7));",
                  "pm.collectionVariables.set(\"thisYear\", today.slice(0, 4));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Has sellerId\",    () => pm.expect(b.sellerId).to.be.a(\"number\"));",
                  "pm.test(\"Has name\",        () => pm.expect(b.name).to.be.a(\"string\"));",
                  "pm.test(\"Has contactInfo\", () => pm.expect(b.contactInfo).to.be.a(\"string\"));",
                  "pm.test(\"Has totalAmount\", () => pm.expect(b.totalAmount).to.exist);",
                  "pm.test(\"period = day\",    () => pm.expect(b.period).to.eql(\"day\"));",
                  "pm.test(\"Top is seller 1\", () => pm.expect(b.sellerId).to.eql(pm.collectionVariables.get(\"sellerId\")));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analytics/topSeller?period=day&date={{today}}",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "topSeller"],
              "query": [
                {
                  "key": "period",
                  "value": "day"
                },
                {
                  "key": "date",
                  "value": "{{today}}"
                }
              ]
            }
          },
          "response": []
        },
